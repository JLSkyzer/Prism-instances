        "1.16.4-2.0.13":"Changelog: https://www.curseforge.com/minecraft/mc-mods/zerocore/files/3135474",
        "1.16.4-2.0.16":"Changelog: https://www.curseforge.com/minecraft/mc-mods/zerocore/files/3138692",
